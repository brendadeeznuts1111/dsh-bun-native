{
  "name": "@local/bun-native",
  "version": "1.2.6",
  "private": true,
  "type": "module",
  "description": "Bun-native project awareness, an offline Bun globals catalog, sandboxed Bun execution, a project doctor, and live Bun docs via a companion MCP bundle.",
  "keywords": ["bun", "bun-native", "workspace", "monorepo", "docs", "mcp", "dsh-plugin"],
  "author": "brendadeeznuts1111",
  "homepage": "https://github.com/brendadeeznuts1111/dsh-bun-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendadeeznuts1111/dsh-bun-native.git",
    "directory": "bun-native"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "bun test ./test",
    "smoke": "bun tools/smoke.mjs",
    "catalog": "bun tools/validate-catalog.mjs",
    "verify:claims": "bun tools/verify-claims.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "data/bun-globals.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
