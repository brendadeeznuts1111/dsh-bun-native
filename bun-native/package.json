{
  "name": "@local/bun-native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bun-native project awareness, an offline Bun globals catalog, and sandboxed Bun execution for the agent.",
  "keywords": ["bun", "bun-native", "workspace", "monorepo", "dsh-plugin"],
  "author": "brendadeeznuts1111",
  "homepage": "https://github.com/brendadeeznuts1111/dsh-bun-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendadeeznuts1111/dsh-bun-native.git",
    "directory": "bun-native"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "data/bun-globals.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
